# ==============================================================================
# Autonomous Agentic Patching & DevSecOps Remediation Bot - Environment Config
# ==============================================================================

# LLM Provider: 'mock' (offline tests), 'ollama' (free local), or 'openai' (API)
LLM_PROVIDER=ollama

# Ollama Configuration (Local, $0 Cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# OpenAI-Compatible API Configuration (Optional)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Redis Configuration (Broker and State Cache)
REDIS_URL=redis://localhost:6379/0

# Ephemeral Docker Sandbox Configuration
SANDBOX_IMAGE=devsecops-remediation-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPU_QUOTA=50000

# Agent Orchestration Settings
MAX_RETRIES=3
LOG_LEVEL=INFO
